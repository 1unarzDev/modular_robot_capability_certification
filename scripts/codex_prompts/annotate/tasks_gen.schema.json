{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "items"
 ],
 "properties": {
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "case_id",
     "domain",
     "title",
     "description",
     "environment",
     "payload_kg",
     "payload_desc",
     "team_modules",
     "duration_s",
     "motion",
     "motion_rationale"
    ],
    "properties": {
     "case_id": {
      "type": "string"
     },
     "domain": {
      "type": "string",
      "enum": [
       "warehouse",
       "rescue",
       "inspection",
       "logistics"
      ]
     },
     "title": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "environment": {
